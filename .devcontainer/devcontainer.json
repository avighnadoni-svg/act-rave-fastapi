{
  "name": "ACT Rave FastAPI",

  "dockerComposeFile": "docker-compose.yml",

  "service": "app",

  "workspaceFolder": "/workspaces/act-rave-fastapi",

  "postCreateCommand": "pip install -r requirements.txt",

  "forwardPorts": [
    8000
  ],

  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}